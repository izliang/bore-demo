{
  "type": "page",
  "title": "$t.settings.title",
  "initApi": "/api/v1/auth/info",
  "aside": {
    "type": "wrapper",
    "size": "none",
    "body": [
      {
        "type": "tpl",
        "tpl": "<div style='padding:28px 20px 20px;border-bottom:1px solid var(--borderColor,#e8e8e8);text-align:center'><div style='display:inline-flex;align-items:center;justify-content:center;width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,#6366f1 0%,#8b5cf6 50%,#a855f7 100%);margin-bottom:12px;box-shadow:0 4px 14px rgba(99,102,241,0.35)'><span style='font-size:26px;line-height:1;color:#fff;filter:drop-shadow(0 1px 2px rgba(0,0,0,0.2))'>⚡</span></div><div style='font-size:17px;font-weight:700;color:var(--textColor,#1a1a2e);line-height:1.3;letter-spacing:0.3px'>bore-demo</div><div style='font-size:11px;color:var(--text--muted-color,#8899bb);margin-top:4px;font-weight:500'>Admin Console</div></div>"
      },
      {
        "type": "nav",
        "stacked": true,
        "className": "w-52 flex-auto",
        "style": {
          "paddingTop": "4px"
        },
        "links": [
          {
            "label": "$t.dashboard.title",
            "to": "/admin/dashboard",
            "icon": "fa fa-dashboard",
            "active": false
          },
          {
            "label": "$t.admins.title",
            "to": "/admin/admins",
            "icon": "fa fa-users",
            "active": false,
            "visibleOn": "this.perms && this.perms.indexOf('admin:list') > -1"
          },
          {
            "label": "$t.roles.title",
            "to": "/admin/roles",
            "icon": "fa fa-user-circle",
            "active": false,
            "visibleOn": "this.perms && this.perms.indexOf('role:list') > -1"
          },
          {
            "label": "$t.menus.title",
            "to": "/admin/menus",
            "icon": "fa fa-list",
            "active": false,
            "visibleOn": "this.perms && this.perms.indexOf('menu:list') > -1"
          },
          {
            "label": "$t.settings.title",
            "to": "/admin/settings",
            "icon": "fa fa-cog",
            "active": true
          }
        ]
      }
    ]
  },
  "asideResizor": true,
  "toolbar": [
    {
      "type": "tpl",
      "tpl": "<span class='text-muted' style='font-size:13px;margin:0 4px'>👤 ${nickname|default:username}</span>"
    },
    {
      "type": "button",
      "label": "$t.common.logout",
      "icon": "fa fa-sign-out",
      "level": "link",
      "actionType": "url",
      "url": "/api/logout",
      "blank": false
    }
  ],
  "body": [
    {
      "type": "panel",
      "title": "$t.settings.basic",
      "body": [
        {
          "type": "static",
          "label": "$t.settings.systemName",
          "value": "bore-demo Admin"
        },
        {
          "type": "static",
          "label": "$t.settings.version",
          "value": "1.0.0"
        }
      ]
    },
    {
      "type": "panel",
      "title": "$t.settings.about",
      "body": [
        {
          "type": "static",
          "label": "$t.settings.description",
          "value": "基于 bore web/amis 的 Go 管理后台示例（RBAC）"
        }
      ]
    }
  ]
}