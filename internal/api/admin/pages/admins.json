{
  "type": "page",
  "title": "$t.admins.title",
  "initApi": "/api/v1/auth/info",
  "aside": {
    "type": "wrapper",
    "size": "none",
    "body": [
      {
        "type": "tpl",
        "tpl": "<div style='padding:28px 20px 20px;border-bottom:1px solid var(--borderColor,#e8e8e8);text-align:center'><div style='display:inline-flex;align-items:center;justify-content:center;width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,#6366f1 0%,#8b5cf6 50%,#a855f7 100%);margin-bottom:12px;box-shadow:0 4px 14px rgba(99,102,241,0.35)'><span style='font-size:26px;line-height:1;color:#fff;filter:drop-shadow(0 1px 2px rgba(0,0,0,0.2))'>⚡</span></div><div style='font-size:17px;font-weight:700;color:var(--textColor,#1a1a2e);line-height:1.3;letter-spacing:0.3px'>bore-demo</div><div style='font-size:11px;color:var(--text--muted-color,#8899bb);margin-top:4px;font-weight:500'>Admin Console</div></div>"
      },
      {
        "type": "nav",
        "stacked": true,
        "className": "w-52 flex-auto",
        "style": {
          "paddingTop": "4px"
        },
        "links": [
          {
            "label": "$t.dashboard.title",
            "to": "/admin/dashboard",
            "icon": "fa fa-dashboard",
            "active": false
          },
          {
            "label": "$t.admins.title",
            "to": "/admin/admins",
            "icon": "fa fa-users",
            "active": true,
            "visibleOn": "this.perms && this.perms.indexOf('admin:list') > -1"
          },
          {
            "label": "$t.roles.title",
            "to": "/admin/roles",
            "icon": "fa fa-user-circle",
            "active": false,
            "visibleOn": "this.perms && this.perms.indexOf('role:list') > -1"
          },
          {
            "label": "$t.menus.title",
            "to": "/admin/menus",
            "icon": "fa fa-list",
            "active": false,
            "visibleOn": "this.perms && this.perms.indexOf('menu:list') > -1"
          },
          {
            "label": "$t.settings.title",
            "to": "/admin/settings",
            "icon": "fa fa-cog",
            "active": false
          }
        ]
      }
    ]
  },
  "asideResizor": true,
  "toolbar": [
    {
      "type": "tpl",
      "tpl": "<span class='text-muted' style='font-size:13px;margin:0 4px'>👤 ${nickname|default:username}</span>"
    },
    {
      "type": "button",
      "label": "$t.common.logout",
      "icon": "fa fa-sign-out",
      "level": "link",
      "actionType": "url",
      "url": "/api/logout",
      "blank": false
    }
  ],
  "body": {
    "type": "crud",
    "syncLocation": false,
    "api": "/api/v1/admin/list",
    "filter": {
      "body": [
        {
          "type": "input-text",
          "name": "keyword",
          "label": "",
          "placeholder": "$t.admins.searchPlaceholder",
          "clearable": true,
          "size": "md"
        }
      ]
    },
    "headerToolbar": [
      {
        "type": "button",
        "label": "$t.admins.add",
        "icon": "fa fa-plus",
        "level": "primary",
        "actionType": "dialog",
        "visibleOn": "this.perms && this.perms.indexOf('admin:add') > -1",
        "dialog": {
          "title": "$t.admins.add",
          "size": "md",
          "body": {
            "type": "form",
            "api": "post:/api/v1/admin/create",
            "body": [
              {
                "type": "input-text",
                "name": "username",
                "label": "$t.admins.username",
                "required": true
              },
              {
                "type": "input-password",
                "name": "password",
                "label": "$t.admins.password",
                "required": true
              },
              {
                "type": "input-text",
                "name": "nickname",
                "label": "$t.admins.nickname"
              },
              {
                "type": "input-email",
                "name": "email",
                "label": "$t.admins.email"
              },
              {
                "type": "input-text",
                "name": "phone",
                "label": "$t.admins.phone"
              },
              {
                "type": "select",
                "name": "role_ids",
                "label": "$t.admins.roles",
                "multiple": true,
                "source": "/api/v1/role/options",
                "valueField": "id",
                "labelField": "role_name"
              },
              {
                "type": "select",
                "name": "status",
                "label": "$t.table.status",
                "options": [
                  {
                    "label": "$t.status.enabled",
                    "value": 1
                  },
                  {
                    "label": "$t.status.disabled",
                    "value": 0
                  }
                ],
                "value": 1
              }
            ]
          }
        }
      },
      {
        "type": "button",
        "label": "$t.common.batchDelete",
        "icon": "fa fa-trash",
        "level": "danger",
        "actionType": "ajax",
        "api": "post:/api/v1/admin/batch-delete",
        "data": {
          "ids": "${ids}"
        },
        "confirmText": "$t.admins.confirmDelete",
        "visibleOn": "this.ids && this.ids.length && this.perms && this.perms.indexOf('admin:remove') > -1"
      }
    ],
    "footerToolbar": [
      "statistics",
      "pagination"
    ],
    "columns": [
      {
        "type": "checkable"
      },
      {
        "name": "id",
        "label": "$t.label.id",
        "width": 70
      },
      {
        "name": "username",
        "label": "$t.admins.username",
        "searchable": true
      },
      {
        "name": "nickname",
        "label": "$t.admins.nickname"
      },
      {
        "name": "email",
        "label": "$t.admins.email"
      },
      {
        "name": "roles",
        "label": "$t.admins.roles",
        "type": "tpl",
        "tpl": "${roles|default:[]|map:role_name|join:', '}"
      },
      {
        "name": "status",
        "label": "$t.table.status",
        "type": "mapping",
        "map": {
          "1": "$t.status.enabled",
          "0": "$t.status.disabled"
        }
      },
      {
        "name": "last_login_at",
        "label": "$t.admins.lastLoginAt",
        "type": "tpl",
        "tpl": "${last_login_at|default:''|dateTime:'YYYY-MM-DD HH:mm:ss'}"
      },
      {
        "name": "created_at",
        "label": "$t.table.createdAt",
        "type": "tpl",
        "tpl": "${created_at|dateTime:'YYYY-MM-DD HH:mm:ss'}"
      },
      {
        "type": "operation",
        "label": "$t.table.action",
        "width": 180,
        "buttons": [
          {
            "type": "button",
            "label": "$t.common.edit",
            "level": "link",
            "actionType": "dialog",
            "visibleOn": "this.perms && this.perms.indexOf('admin:edit') > -1",
            "dialog": {
              "title": "$t.admins.edit",
              "size": "md",
              "body": {
                "type": "form",
                "api": "put:/api/v1/admin/update",
                "initApi": "get:/api/v1/admin/get?id=${id}",
                "body": [
                  {
                    "type": "input-text",
                    "name": "username",
                    "label": "$t.admins.username",
                    "required": true
                  },
                  {
                    "type": "input-password",
                    "name": "password",
                    "label": "$t.admins.password",
                    "placeholder": "$t.admins.passwordEditPlaceholder"
                  },
                  {
                    "type": "input-text",
                    "name": "nickname",
                    "label": "$t.admins.nickname"
                  },
                  {
                    "type": "input-email",
                    "name": "email",
                    "label": "$t.admins.email"
                  },
                  {
                    "type": "input-text",
                    "name": "phone",
                    "label": "$t.admins.phone"
                  },
                  {
                    "type": "select",
                    "name": "role_ids",
                    "label": "$t.admins.roles",
                    "multiple": true,
                    "source": "/api/v1/role/options",
                    "valueField": "id",
                    "labelField": "role_name"
                  },
                  {
                    "type": "select",
                    "name": "status",
                    "label": "$t.table.status",
                    "options": [
                      {
                        "label": "$t.status.enabled",
                        "value": 1
                      },
                      {
                        "label": "$t.status.disabled",
                        "value": 0
                      }
                    ]
                  }
                ]
              }
            }
          },
          {
            "type": "button",
            "label": "$t.common.delete",
            "level": "link",
            "className": "text-danger",
            "actionType": "ajax",
            "api": "delete:/api/v1/admin/delete?id=${id}",
            "confirmText": "$t.admins.confirmDelete",
            "visibleOn": "this.perms && this.perms.indexOf('admin:remove') > -1"
          }
        ]
      }
    ]
  }
}