{
  "type": "page",
  "title": "",
  "body": [
    {
      "type": "wrapper",
      "style": {
        "display": "flex",
        "justifyContent": "center",
        "alignItems": "center",
        "height": "100vh",
        "background": "linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%)"
      },
      "body": {
        "type": "container",
        "style": {
          "width": "400px",
          "padding": "48px 40px 36px",
          "background": "#fff",
          "borderRadius": "12px",
          "boxShadow": "0 20px 60px rgba(0,0,0,0.5)"
        },
        "body": [
          {
            "type": "tpl",
            "tpl": "<div style='padding:28px 20px 20px;border-bottom:1px solid var(--borderColor,#e8e8e8);text-align:center'><div style='display:inline-flex;align-items:center;justify-content:center;width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,#6366f1 0%,#8b5cf6 50%,#a855f7 100%);margin-bottom:12px;box-shadow:0 4px 14px rgba(99,102,241,0.35)'><span style='font-size:26px;line-height:1;color:#fff;filter:drop-shadow(0 1px 2px rgba(0,0,0,0.2))'>⚡</span></div><div style='font-size:17px;font-weight:700;color:var(--textColor,#1a1a2e);line-height:1.3;letter-spacing:0.3px'>bore-demo</div><div style='font-size:11px;color:var(--text--muted-color,#8899bb);margin-top:4px;font-weight:500'>Admin Console</div></div>"
          },
          {
            "type": "form",
            "title": "",
            "mode": "normal",
            "wrapWithPanel": false,
            "api": {
              "method": "post",
              "url": "/api/login"
            },
            "body": [
              {
                "type": "input-text",
                "name": "username",
                "label": "$t.auth.username",
                "placeholder": "$t.auth.usernamePlaceholder",
                "required": true,
                "size": "full"
              },
              {
                "type": "input-password",
                "name": "password",
                "label": "$t.auth.password",
                "placeholder": "$t.auth.passwordPlaceholder",
                "required": true,
                "size": "full"
              },
              {
                "type": "button",
                "label": "$t.common.signIn",
                "level": "primary",
                "block": true,
                "size": "lg",
                "actionType": "submit"
              }
            ],
            "onEvent": {
              "submitSucc": {
                "actions": [
                  {
                    "actionType": "url",
                    "args": {
                      "url": "${event.data.result.data.redirect || '/admin/dashboard'}",
                      "blank": false
                    }
                  }
                ]
              }
            }
          },
          {
            "type": "tpl",
            "tpl": "<div style='text-align:center;margin-top:20px;color:#bcc;font-size:12px'>Demo: admin / admin123</div>"
          }
        ]
      }
    }
  ]
}