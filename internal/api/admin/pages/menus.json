{
  "type": "page",
  "title": "$t.menus.title",
  "initApi": "/api/v1/auth/info",
  "aside": {
    "type": "wrapper",
    "size": "none",
    "body": [
      {
        "type": "tpl",
        "tpl": "<div style='padding:28px 20px 20px;border-bottom:1px solid var(--borderColor,#e8e8e8);text-align:center'><div style='display:inline-flex;align-items:center;justify-content:center;width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg,#6366f1 0%,#8b5cf6 50%,#a855f7 100%);margin-bottom:12px;box-shadow:0 4px 14px rgba(99,102,241,0.35)'><span style='font-size:26px;line-height:1;color:#fff;filter:drop-shadow(0 1px 2px rgba(0,0,0,0.2))'>⚡</span></div><div style='font-size:17px;font-weight:700;color:var(--textColor,#1a1a2e);line-height:1.3;letter-spacing:0.3px'>bore-demo</div><div style='font-size:11px;color:var(--text--muted-color,#8899bb);margin-top:4px;font-weight:500'>Admin Console</div></div>"
      },
      {
        "type": "nav",
        "stacked": true,
        "className": "w-52 flex-auto",
        "style": {
          "paddingTop": "4px"
        },
        "links": [
          {
            "label": "$t.dashboard.title",
            "to": "/admin/dashboard",
            "icon": "fa fa-dashboard",
            "active": false
          },
          {
            "label": "$t.admins.title",
            "to": "/admin/admins",
            "icon": "fa fa-users",
            "active": false,
            "visibleOn": "this.perms && this.perms.indexOf('admin:list') > -1"
          },
          {
            "label": "$t.roles.title",
            "to": "/admin/roles",
            "icon": "fa fa-user-circle",
            "active": false,
            "visibleOn": "this.perms && this.perms.indexOf('role:list') > -1"
          },
          {
            "label": "$t.menus.title",
            "to": "/admin/menus",
            "icon": "fa fa-list",
            "active": true,
            "visibleOn": "this.perms && this.perms.indexOf('menu:list') > -1"
          },
          {
            "label": "$t.settings.title",
            "to": "/admin/settings",
            "icon": "fa fa-cog",
            "active": false
          }
        ]
      }
    ]
  },
  "asideResizor": true,
  "toolbar": [
    {
      "type": "tpl",
      "tpl": "<span class='text-muted' style='font-size:13px;margin:0 4px'>👤 ${nickname|default:username}</span>"
    },
    {
      "type": "button",
      "label": "$t.common.logout",
      "icon": "fa fa-sign-out",
      "level": "link",
      "actionType": "url",
      "url": "/api/logout",
      "blank": false
    }
  ],
  "body": {
    "type": "crud",
    "syncLocation": false,
    "api": "/api/v1/menu/tree",
    "childrenColumnName": "children",
    "headerToolbar": [
      {
        "type": "button",
        "label": "$t.menus.add",
        "icon": "fa fa-plus",
        "level": "primary",
        "actionType": "dialog",
        "visibleOn": "this.perms && this.perms.indexOf('menu:add') > -1",
        "dialog": {
          "title": "$t.menus.add",
          "size": "md",
          "body": {
            "type": "form",
            "api": "post:/api/v1/menu/create",
            "body": [
              {
                "type": "input-text",
                "name": "menu_name",
                "label": "$t.menus.menuName",
                "required": true
              },
              {
                "type": "select",
                "name": "menu_type",
                "label": "$t.menus.menuType",
                "required": true,
                "options": [
                  {
                    "label": "$t.menus.dir",
                    "value": "M"
                  },
                  {
                    "label": "$t.menus.menu",
                    "value": "C"
                  },
                  {
                    "label": "$t.menus.button",
                    "value": "F"
                  }
                ],
                "value": "C"
              },
              {
                "type": "tree-select",
                "name": "parent_id",
                "label": "$t.menus.parentMenu",
                "source": "/api/v1/menu/tree",
                "valueField": "id",
                "labelField": "menu_name",
                "childrenField": "children",
                "clearable": true
              },
              {
                "type": "input-text",
                "name": "path",
                "label": "$t.menus.path"
              },
              {
                "type": "input-text",
                "name": "perms",
                "label": "$t.menus.perms"
              },
              {
                "type": "input-text",
                "name": "icon",
                "label": "$t.menus.icon"
              },
              {
                "type": "input-number",
                "name": "order_num",
                "label": "$t.menus.orderNum",
                "value": 0
              },
              {
                "type": "select",
                "name": "visible",
                "label": "$t.menus.visible",
                "options": [
                  {
                    "label": "$t.status.enabled",
                    "value": 1
                  },
                  {
                    "label": "$t.status.disabled",
                    "value": 0
                  }
                ],
                "value": 1
              }
            ]
          }
        }
      }
    ],
    "columns": [
      {
        "name": "menu_name",
        "label": "$t.menus.menuName"
      },
      {
        "name": "menu_type",
        "label": "$t.menus.menuType",
        "type": "mapping",
        "map": {
          "M": "$t.menus.dir",
          "C": "$t.menus.menu",
          "F": "$t.menus.button"
        }
      },
      {
        "name": "perms",
        "label": "$t.menus.perms"
      },
      {
        "name": "path",
        "label": "$t.menus.path"
      },
      {
        "name": "icon",
        "label": "$t.menus.icon"
      },
      {
        "name": "order_num",
        "label": "$t.menus.orderNum",
        "width": 90
      },
      {
        "name": "visible",
        "label": "$t.menus.visible",
        "type": "mapping",
        "map": {
          "1": "$t.status.enabled",
          "0": "$t.status.disabled"
        }
      },
      {
        "type": "operation",
        "label": "$t.table.action",
        "width": 170,
        "buttons": [
          {
            "type": "button",
            "label": "$t.common.edit",
            "level": "link",
            "actionType": "dialog",
            "visibleOn": "this.perms && this.perms.indexOf('menu:edit') > -1",
            "dialog": {
              "title": "$t.menus.edit",
              "size": "md",
              "body": {
                "type": "form",
                "api": "put:/api/v1/menu/update",
                "initApi": "get:/api/v1/menu/get?id=${id}",
                "body": [
                  {
                    "type": "input-text",
                    "name": "menu_name",
                    "label": "$t.menus.menuName",
                    "required": true
                  },
                  {
                    "type": "select",
                    "name": "menu_type",
                    "label": "$t.menus.menuType",
                    "required": true,
                    "options": [
                      {
                        "label": "$t.menus.dir",
                        "value": "M"
                      },
                      {
                        "label": "$t.menus.menu",
                        "value": "C"
                      },
                      {
                        "label": "$t.menus.button",
                        "value": "F"
                      }
                    ],
                    "value": "C"
                  },
                  {
                    "type": "tree-select",
                    "name": "parent_id",
                    "label": "$t.menus.parentMenu",
                    "source": "/api/v1/menu/tree",
                    "valueField": "id",
                    "labelField": "menu_name",
                    "childrenField": "children",
                    "clearable": true
                  },
                  {
                    "type": "input-text",
                    "name": "path",
                    "label": "$t.menus.path"
                  },
                  {
                    "type": "input-text",
                    "name": "perms",
                    "label": "$t.menus.perms"
                  },
                  {
                    "type": "input-text",
                    "name": "icon",
                    "label": "$t.menus.icon"
                  },
                  {
                    "type": "input-number",
                    "name": "order_num",
                    "label": "$t.menus.orderNum",
                    "value": 0
                  },
                  {
                    "type": "select",
                    "name": "visible",
                    "label": "$t.menus.visible",
                    "options": [
                      {
                        "label": "$t.status.enabled",
                        "value": 1
                      },
                      {
                        "label": "$t.status.disabled",
                        "value": 0
                      }
                    ],
                    "value": 1
                  }
                ]
              }
            }
          },
          {
            "type": "button",
            "label": "$t.common.delete",
            "level": "link",
            "className": "text-danger",
            "actionType": "ajax",
            "api": "delete:/api/v1/menu/delete?id=${id}",
            "confirmText": "$t.menus.confirmDelete",
            "visibleOn": "this.perms && this.perms.indexOf('menu:remove') > -1"
          }
        ]
      }
    ]
  }
}